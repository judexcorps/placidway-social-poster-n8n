        "jsCode": "const d = $('Build Verify Prompt').first().json;\nconst resp = $input.first().json;\nlet verdict;\ntry {\n  const t = ((resp.candidates || [])[0]?.content?.parts || []).map(p => p.text || '').join('');\n  verdict = JSON.parse(t.replace(/^```json/i, '').replace(/```$/, '').trim());\n} catch (e) {\n  verdict = { pass: false, issues: ['verifier_response_unparseable'] }; // fail closed\n}\nconst guard_pass = verdict.pass === true;\nconst failures = guard_pass ? [] : (verdict.issues && verdict.issues.length ? verdict.issues : ['verifier_rejected']).map(i => 'llm_check:' + i);\nconst { verify_body, ...rest } = d;\nreturn [{ json: { ...rest, guard_pass, failures, verdict } }];"
      },
