    {
      "parameters": {
        "jsCode": "const candidates = $('Parse Sitemap').all().map(i => i.json);\nconst posted = new Set($input.all().map(i => String(i.json.url || '').trim()).filter(Boolean));\n// Skip regulated/sensitive topics and non-English pages: safer demo content.\nconst skip = /(ibogaine|addiction|rehab|opiate|opioid|fentanyl|heroin|gender|erectile|penile|tubal|donation|autism|Gastrico|Descubre|Opciones|Paquetes|cancer|stem-cell|parkinson|longevity|anti-aging|oncology|chemo)/i;\nconst pick = candidates.find(c => c.url && !posted.has(c.url) && !skip.test(c.url));\nif (!pick) throw new Error('No unposted, eligible article found among the 30 newest sitemap entries');\nreturn [{ json: pick }];"
      },
