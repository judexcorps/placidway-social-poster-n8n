    {
      "parameters": {
        "jsCode": "const html = $input.first().json.data || '';\nconst pick = $('Pick Article').first().json;\nconst decode = s => (s || '').replace(/&amp;/g, '&').replace(/&quot;/g, '\"').replace(/&#0?39;/g, \"'\").replace(/&#x27;/g, \"'\").replace(/&apos;/g, \"'\").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&nbsp;/g, ' ').trim();\nconst meta = (key) => {\n  const re1 = new RegExp('<meta[^>]+(?:property|name)=[\"\\']' + key + '[\"\\'][^>]*content=[\"\\']([^\"\\']*)[\"\\']', 'i');\n  const re2 = new RegExp('<meta[^>]+content=[\"\\']([^\"\\']*)[\"\\'][^>]*(?:property|name)=[\"\\']' + key + '[\"\\']', 'i');\n  const m = html.match(re1) || html.match(re2);\n  return m ? decode(m[1]) : '';\n};\nlet title = meta('og:title') || decode((html.match(/<title[^>]*>([\\s\\S]*?)<\\/title>/i) || [])[1]);\ntitle = title.replace(/\\s*[\\|\\-–]\\s*PlacidWay.*$/i, '').trim();\nconst summary = meta('og:description') || meta('description');\nconst image = meta('og:image') || pick.image || '';\nconst paras = [...html.matchAll(/<p[^>]*>([\\s\\S]*?)<\\/p>/gi)]\n  .map(m => decode(m[1].replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ')))\n  .filter(t => t.length > 40);\nconst source_text = (summary + '\\n' + paras.join('\\n')).slice(0, 4000);\nif (!title || source_text.length < 100) throw new Error('Could not extract enough content from ' + pick.url);\nreturn [{ json: { url: pick.url, lastmod: pick.lastmod, title, summary, image, source_text } }];"
      },
      "id": "e9f25463-d4f7-4e6c-8c04-4b5fd971fcab",
      "name": "Extract Article",
      "type": "n8n-nodes-base.code",
