      "parameters": {
        "jsCode": "const xml = $input.first().json.data || '';\nconst blocks = xml.split('<url>').slice(1);\nconst items = [];\nfor (const b of blocks) {\n  const url = (b.match(/<loc>(.*?)<\\/loc>/) || [])[1];\n  if (!url) continue;\n  const lastmod = (b.match(/<lastmod>(.*?)<\\/lastmod>/) || [])[1] || '';\n  const image = ((b.match(/<image:loc>(.*?)<\\/image:loc>/) || [])[1] || '').replace(/&amp;/g, '&');\n  items.push({ json: { url: url.trim(), lastmod, image } });\n}\nif (!items.length) throw new Error('Sitemap parsed but contained no article URLs');\nreturn items.slice(0, 30);"
      },
