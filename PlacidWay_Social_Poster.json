      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst system = [\n  'You are a strict compliance reviewer for medical-tourism marketing posts.',\n  'Compare the POST against the SOURCE. Fail the post if it contains any factual claim not supported by the SOURCE, any medical claim, any promise or implication of a treatment outcome, or any price or statistic not in the SOURCE.',\n  'Respond with JSON only, exactly in this shape: {\"pass\": true|false, \"issues\": [\"short description\", ...]}. Use an empty issues array when pass is true.'\n].join('\\n');\nconst user = 'SOURCE:\\n' + d.source_text + '\\n\\nPOST:\\n' + d.draft;\nconst verify_body = {\n  systemInstruction: { parts: [{ text: system }] },\n  contents: [{ role: 'user', parts: [{ text: user }] }],\n  generationConfig: { temperature: 0, maxOutputTokens: 2048, responseMimeType: 'application/json' }\n};\nreturn [{ json: { ...d, verify_body } }];"
