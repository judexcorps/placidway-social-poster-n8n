        "jsCode": "const d = $input.first().json;\nconst cfg = $('Config1').first().json;\nconst base = 'https://graph.facebook.com/' + cfg.fb_api_version + '/' + cfg.fb_page_id;\n// With an image: photo post (image + caption). Without: text post with link. Page token is added by the credential, never stored here.\nconst fb = d.image\n  ? { endpoint: base + '/photos', body: { url: d.image, caption: d.post_text } }\n  : { endpoint: base + '/feed', body: { message: d.post_text, link: d.url } };\nreturn [{ json: { ...d, fb } }];"
