    {
      "parameters": {
        "jsCode": "const ctx = $('Build Write Prompt').first().json;\nconst resp = $input.first().json;\nlet text = ((resp.candidates || [])[0]?.content?.parts || []).map(p => p.text || '').join('').trim();\ntext = text.replace(/^```[a-z]*\\n?/i, '').replace(/```$/, '').trim();\ntext = text.replace(/https?:\\/\\/\\S+/g, '').trim(); // the link is appended by code, never by the model\n\nconst failures = [];\nif (!text) failures.push('empty_generation');\nif (text.length > 500) failures.push('too_long:' + text.length);\nconst tags = text.match(/#\\w+/g) || [];\nif (tags.length < 3 || tags.length > 5) failures.push('hashtag_count:' + tags.length);\nconst banned = /\\b(cure[sd]?|curing|guarantee[sd]?|miracle|risk[- ]free|painless|no side effects|proven to)\\b|100\\s?%/i;\nconst b = text.match(banned);\nif (b) failures.push('banned_word:' + b[0]);\nconst src = ctx.source_text.toLowerCase();\nconst body = text.replace(/#\\w+/g, '').replace(/[ \\t]+\\n/g, '\\n').replace(/\\n{3,}/g, '\\n\\n').trim();\nconst nums = body.match(/[$€£]\\s?\\d[\\d,.]*|\\d[\\d,.]*\\s?%|\\b\\d{2,}[\\d,.]*\\b/g) || [];\nfor (const n of nums) {\n  if (!src.includes(n.trim().toLowerCase())) failures.push('number_not_in_source:' + n.trim());\n}\n\nconst cfg = $('Config1').first().json;\nconst publish = cfg.publish_enabled === true || String(cfg.publish_enabled).toLowerCase() === 'true';\nconst route = cfg.mode === 'approval' ? 'approval' : (publish ? 'publish' : 'dry_run');\nconst { write_body, ...rest } = ctx;\nreturn [{ json: { ...rest, draft: text, post_text: body + '\\n\\n' + ctx.url + '\\n\\n' + tags.join(' '), route, rule_pass: failures.length === 0, failures } }];"
      },
