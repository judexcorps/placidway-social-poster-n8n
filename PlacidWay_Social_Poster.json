    {
      "parameters": {
        "jsCode": "const a = $input.first().json;\nconst system = [\n  'You write ONE Facebook post for PlacidWay, a medical tourism marketplace, based ONLY on the SOURCE TEXT provided.',\n  'Format: line 1 is a short hook; then 2-4 short lines of value taken from the source; then one call-to-action line inviting readers to read the full article (do NOT include any URL, it is added automatically); the last line has 3-5 relevant hashtags.',\n  'Keep the whole post under 420 characters.',\n  'Rules: make no medical claims and promise no outcomes; state no prices, percentages, statistics or numbers unless they appear in the source; invent no facts; never use the words cure, guarantee, miracle or risk-free; keep a neutral, informative tone; where relevant, remind readers to consult a qualified medical professional.',\n  'Output only the post text.'\n].join('\\n');\nconst user = 'ARTICLE TITLE: ' + a.title + '\\n\\nSOURCE TEXT:\\n' + a.source_text;\nconst write_body = {\n  systemInstruction: { parts: [{ text: system }] },\n  contents: [{ role: 'user', parts: [{ text: user }] }],\n  generationConfig: { temperature: 0.4, maxOutputTokens: 2048 }\n};\nreturn [{ json: { ...a, write_body } }];"
      },
